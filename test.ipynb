import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from scipy.optimize import curve_fit
from scipy.signal import find_peaks


# ============================================================
# 1. Excel 파일 불러오기
# ============================================================

file = "spectrum.xlsx"

df = pd.read_excel(file)

wavelength = df.iloc[:, 0].to_numpy(dtype=float)
absorbance = df.iloc[:, 1].to_numpy(dtype=float)


# wavelength 순서 정렬
order = np.argsort(wavelength)

wavelength = wavelength[order]
absorbance = absorbance[order]


# ============================================================
# 2. Gaussian 함수
# ============================================================

def gaussian(x, amplitude, center, sigma):
    return amplitude * np.exp(
        -(x - center)**2 / (2 * sigma**2)
    )


# ============================================================
# 3. 여러 Gaussian의 합
# ============================================================

def multi_gaussian(x, *params):

    n_peaks = len(params) // 3

    y = np.zeros_like(x)

    for i in range(n_peaks):
        amplitude = params[3*i]
        center = params[3*i + 1]
        sigma = params[3*i + 2]

        y += gaussian(
            x,
            amplitude,
            center,
            sigma
        )

    return y


# ============================================================
# 4. Peak 개수 설정
# ============================================================

n_peaks = 3


# ============================================================
# 5. 초기 peak 위치 자동 탐색
# ============================================================

peak_indices, properties = find_peaks(
    absorbance,
    prominence=0.01,
    distance=10
)


# prominence가 큰 순서로 정렬
peak_indices = peak_indices[
    np.argsort(properties["prominences"])[::-1]
]


# 필요한 peak 수만 선택
peak_indices = peak_indices[:n_peaks]


# peak 위치
initial_centers = wavelength[peak_indices]


# peak 높이
initial_amplitudes = absorbance[peak_indices]


# 초기 sigma
initial_sigma = 10.0


# ============================================================
# 6. 초기 parameter 생성
# ============================================================

initial_guess = []

for amplitude, center in zip(
    initial_amplitudes,
    initial_centers
):

    initial_guess.extend([
        amplitude,
        center,
        initial_sigma
    ])


# ============================================================
# 7. Parameter 범위 설정
# ============================================================

lower_bounds = []
upper_bounds = []

for _ in range(n_peaks):

    lower_bounds.extend([
        0,                  # amplitude
        wavelength.min(),   # center
        0.1                 # sigma
    ])

    upper_bounds.extend([
        np.inf,
        wavelength.max(),
        100
    ])


# ============================================================
# 8. Curve fitting
# ============================================================

popt, pcov = curve_fit(
    multi_gaussian,
    wavelength,
    absorbance,
    p0=initial_guess,
    bounds=(lower_bounds, upper_bounds),
    maxfev=100000
)


# ============================================================
# 9. Fitted spectrum
# ============================================================

fitted = multi_gaussian(
    wavelength,
    *popt
)


# ============================================================
# 10. R² 계산
# ============================================================

residual = absorbance - fitted

ss_res = np.sum(residual**2)
ss_tot = np.sum(
    (absorbance - np.mean(absorbance))**2
)

r_squared = 1 - ss_res / ss_tot


print(f"R² = {r_squared:.6f}")


# ============================================================
# 11. Peak parameter 출력
# ============================================================

results = []

for i in range(n_peaks):

    amplitude = popt[3*i]
    center = popt[3*i + 1]
    sigma = popt[3*i + 2]

    # Gaussian FWHM
    fwhm = 2 * np.sqrt(2 * np.log(2)) * sigma

    # Gaussian area
    area = amplitude * sigma * np.sqrt(2 * np.pi)

    results.append({
        "Peak": i + 1,
        "Center (nm)": center,
        "Height": amplitude,
        "Sigma (nm)": sigma,
        "FWHM (nm)": fwhm,
        "Area": area
    })


results_df = pd.DataFrame(results)

print("\nPeak parameters:")
print(results_df)


# ============================================================
# 12. 각각의 deconvoluted peak 계산
# ============================================================

components = []

for i in range(n_peaks):

    amplitude = popt[3*i]
    center = popt[3*i + 1]
    sigma = popt[3*i + 2]

    component = gaussian(
        wavelength,
        amplitude,
        center,
        sigma
    )

    components.append(component)


# ============================================================
# 13. 그래프
# ============================================================

plt.figure(figsize=(10, 6))

# Raw spectrum
plt.plot(
    wavelength,
    absorbance,
    label="Experimental",
    linewidth=2
)

# Total fitting
plt.plot(
    wavelength,
    fitted,
    "--",
    label="Total fit",
    linewidth=2
)

# Individual peaks
for i, component in enumerate(components):

    plt.plot(
        wavelength,
        component,
        ":",
        linewidth=1.5,
        label=f"Peak {i+1}"
    )


plt.xlabel("Wavelength (nm)")
plt.ylabel("Absorbance")

plt.legend()

plt.tight_layout()

plt.show()


# ============================================================
# 14. 결과를 Excel로 저장
# ============================================================

output = pd.DataFrame({
    "Wavelength (nm)": wavelength,
    "Experimental": absorbance,
    "Fitted": fitted
})


for i, component in enumerate(components):

    output[f"Peak {i+1}"] = component


output.to_excel(
    "peak_deconvolution_result.xlsx",
    index=False
)

results_df.to_excel(
    "peak_parameters.xlsx",
    index=False
)


print("\n분석 완료!")
print("peak_deconvolution_result.xlsx")
print("peak_parameters.xlsx")
